#设计一个学生成绩管理系统
names =[]  #定义两个空列表，一个代表姓名一个代表分数
scores = []

while True:  #打印菜单，使用true进行死循环，只有见到break才会退出循环
    print("欢迎使用学生成绩管理系统")
    print("1. 添加学生")
    print("2.查看所有学生")
    print("3.查询学生成绩")
    print("4.统计成绩信息")
    print("5.删除学生")
    print("0.退出系统")

    choice = input("请输入您的选择：")
#条件判定对应选项并执行任务
    if choice == "0":
        print("退出系统")
        break
    elif choice == "1":
        print("添加学生")
        name = input("请输入学生姓名：")
        score = float(input("请输入学生成绩："))
        names.append(name)#append()方法用于在列表末尾添加新的对象
        scores.append(score)
        print("学生添加成功！")
    elif choice == "2":
        print("查看所有学生")
        if len(names) == 0:
         print("目前没有学生信息！")

        else:
         for i in range(len(names)):

            print(
                "姓名：", names[i],
                "成绩：", scores[i]
            )
    elif choice == "3":
        print("查询学生成绩")
        search_name = input("请输入要查询的学生姓名：")

        found = False

        for i in range(len(names)):

           if names[i] == search_name:

            print("查询成功！")
            print("姓名：", names[i])
            print("成绩：", scores[i])
            if scores[i] >= 90:
                print("成绩等级：优秀")
            elif scores[i] >= 80:
                print("成绩等级：良好")
            elif scores[i] >= 70:
                print("成绩等级：中等")
            elif scores[i] >= 60:
                print("成绩等级：及格")
            else:
                print("成绩等级：不及格")
            found = True
            break

        if found == False:
           print("没有找到该学生！")
    elif choice == "4":
        print("统计成绩信息")
        if len(scores) == 0:
            print("目前没有学生成绩信息！")
        else:
            total_score = sum(scores)
            average_score = total_score / len(scores)
            max_score = max(scores)
            min_score = min(scores)

            print("总成绩：", total_score)
            print("平均成绩：", average_score)
            print("最高成绩：", max_score)
            print("最低成绩：", min_score)
    elif choice == "5":
        print("删除学生")
        delete_name = input("请输入要删除的学生姓名：")
        found = False
        for i in range(len(names)):
            if names[i] == delete_name:
                names.pop(i)
                scores.pop(i)
                print("学生删除成功！")
                found = True
                break
        if not found:#not found就表示没有找到该学生，not found是found的取反，found为True时，not found为False，found为False时，not found为True
            print("没有找到该学生！")
    else:
        print("无效的选择，请重新输入")
