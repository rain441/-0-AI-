
# ==================================
# 学生成绩管理系统（第四课升级版）
# ==================================

# 元组：固定的成绩等级
LEVELS = ("优秀", "良好", "及格", "不及格")

# 字典：保存所有学生信息
students = {}


# 根据成绩判断等级
def get_level(score):

    if score >= 90:
        return LEVELS[0]

    elif score >= 80:
        return LEVELS[1]

    elif score >= 60:
        return LEVELS[2]

    else:
        return LEVELS[3]


# 添加学生
def add_student(students):

    student_id = input("请输入学生学号：")

    if student_id in students:
        print("该学号已经存在！")
        return

    name = input("请输入学生姓名：")
    age = int(input("请输入学生年龄："))
    score = float(input("请输入学生成绩："))

    if score < 0 or score > 100:
        print("成绩必须在 0 到 100 之间！")
        return

    students[student_id] = {
        "name": name,
        "age": age,
        "score": score
    }

    print("学生添加成功！")


# 查看所有学生
def show_students(students):

    if len(students) == 0:
        print("目前没有学生信息！")
        return

    print("\n========== 学生信息 ==========")

    for student_id, info in students.items():

        print("学号：", student_id)
        print("姓名：", info["name"])
        print("年龄：", info["age"])
        print("成绩：", info["score"])
        print("等级：", get_level(info["score"]))
        print("------------------------")


# 查询学生
def search_student(students):

    student_id = input("请输入要查询的学号：")

    info = students.get(student_id)

    if info is None:
        print("没有找到该学生！")
        return

    print("查询成功！")
    print("学号：", student_id)
    print("姓名：", info["name"])
    print("年龄：", info["age"])
    print("成绩：", info["score"])
    print("等级：", get_level(info["score"]))


# 统计成绩
def statistics(students):

    if len(students) == 0:
        print("暂无成绩数据！")
        return

    scores = []

    for info in students.values():
        scores.append(info["score"])

    total = sum(scores)
    average = total / len(scores)

    print("\n========== 成绩统计 ==========")
    print("学生人数：", len(scores))
    print("总成绩：", total)
    print("平均成绩：", round(average, 2))
    print("最高成绩：", max(scores))
    print("最低成绩：", min(scores))

    used_levels = set()

    for score in scores:
        used_levels.add(get_level(score))

    print("本班出现的成绩等级：", used_levels)


# 删除学生
def delete_student(students):

    student_id = input("请输入要删除的学号：")

    if student_id not in students:
        print("没有找到该学生！")
        return

    student = students.pop(student_id)

    print("学生删除成功！")
    print("已删除：", student["name"])


# 主程序
while True:

    print("\n========== 学生成绩管理系统 ==========")
    print("1. 添加学生")
    print("2. 查看所有学生")
    print("3. 查询学生")
    print("4. 统计成绩")
    print("5. 删除学生")
    print("0. 退出系统")

    choice = input("请输入功能编号：")

    if choice == "1":
        add_student(students)

    elif choice == "2":
        show_students(students)

    elif choice == "3":
        search_student(students)

    elif choice == "4":
        statistics(students)

    elif choice == "5":
        delete_student(students)

    elif choice == "0":
        print("系统已退出！")
        break

    else:
        print("输入错误，请重新选择！")

